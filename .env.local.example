# Frontend environment example
# Copy to frontend/.env.local for local development.
# NEXT_PUBLIC values are bundled into the browser and visible to users.

NEXT_PUBLIC_API_URL=https://your-site.example.com/api
NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# Public Supabase browser client values only. Do not put service_role here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me_public_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_me_public_publishable_key

# Server-side Next.js API route proxy target. Do not expose secrets here.
BACKEND_API_URL=https://your-backend.example.com
ALLOWED_ORIGINS=https://your-site.example.com
