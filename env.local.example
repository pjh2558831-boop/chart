# Legacy frontend env example kept for compatibility.
# Prefer frontend/.env.local.example for new setup.
# NEXT_PUBLIC and VITE values are visible to browser users.

NEXT_PUBLIC_SITE_URL=https://your-site.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me_public_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_me_public_publishable_key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me_public_anon_key

BACKEND_API_URL=https://your-backend.example.com
ALLOWED_ORIGINS=https://your-site.example.com
ENABLE_PERFORMANCE_DEBUG=false
ENABLE_GLOBAL_IMAGE_CACHE=false
DEFAULT_ANALYSIS_MODE=standard
