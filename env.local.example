# Public frontend variables. These are safe to expose in the browser bundle.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=https://gagmrekcngcentpmuweg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Vite-compatible aliases kept for future migration/reference.
VITE_SUPABASE_URL=https://gagmrekcngcentpmuweg.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only variables used by Next.js API routes. Do not prefix these with NEXT_PUBLIC.
BACKEND_API_URL=http://localhost:8001
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_PERFORMANCE_DEBUG=false
ENABLE_GLOBAL_IMAGE_CACHE=false
DEFAULT_ANALYSIS_MODE=standard

# Optional: only needed if you use app/api/examples/openai-secure directly.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
